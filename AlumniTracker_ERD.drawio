    <mxCell id="cell_8" value="&lt;div style=&quot;font-family:Arial,sans-serif;color:#000000;padding:6px;&quot;&gt; &lt;div style=&quot;font-size:12px;font-weight:bold;text-align:center;border-bottom:1px solid #000000;padding-bottom:4px;margin-bottom:6px;&quot;&gt; ERD FORMAL NOTATION LEGEND (MONOCHROME) &lt;/div&gt; &lt;table style=&quot;width:100%;font-size:10px;line-height:18px;border-collapse:collapse;&quot;&gt; &lt;tr&gt; &lt;td style=&quot;width:120px;font-weight:bold;&quot;&gt;Single Border Rect:&lt;/td&gt; &lt;td&gt;&lt;b&gt;Strong Entity&lt;/b&gt; (Independent existence, primary table)&lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td style=&quot;font-weight:bold;&quot;&gt;Double Border Rect:&lt;/td&gt; &lt;td&gt;&lt;b&gt;Weak Entity&lt;/b&gt; (Dependent existence, requires parent foreign key)&lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td style=&quot;font-weight:bold;&quot;&gt;Solid Black Line:&lt;/td&gt; &lt;td&gt;&lt;b&gt;Strong Identifying Relationship&lt;/b&gt; (ON DELETE CASCADE, parent existence required)&lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td style=&quot;font-weight:bold;&quot;&gt;Broken / Dashed Line:&lt;/td&gt; &lt;td&gt;&lt;b&gt;Weak Non-Identifying Relationship&lt;/b&gt; (ON DELETE SET NULL, optional reference)&lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td style=&quot;font-weight:bold;&quot;&gt;Crow&amp;#39;s Foot End:&lt;/td&gt; &lt;td&gt;&lt;b&gt;Many (N)&lt;/b&gt; cardinality endpoint&lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td style=&quot;font-weight:bold;&quot;&gt;Crossbar End:&lt;/td&gt; &lt;td&gt;&lt;b&gt;Exactly One (1)&lt;/b&gt; cardinality endpoint&lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td style=&quot;font-weight:bold;&quot;&gt;Ring + Crossbar:&lt;/td&gt; &lt;td&gt;&lt;b&gt;Zero or One (0..1)&lt;/b&gt; optional cardinality endpoint&lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td style=&quot;font-weight:bold;&quot;&gt;Key Indicators:&lt;/td&gt; &lt;td&gt;&lt;b&gt;[PK]&lt;/b&gt; Primary Key &amp;bull; &lt;b&gt;[UK]&lt;/b&gt; Unique Key &amp;bull; &lt;b&gt;[FK]&lt;/b&gt; Foreign Key&lt;/td&gt; &lt;/tr&gt; &lt;/table&gt; &lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="60" y="1460" width="450" height="200" as="geometry" />
    </mxCell>
  
