PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
# The JWT secret that signs the Supabase anon key. Required for user-facing
# queries to be scoped via Row Level Security (PostgREST validates tokens with
# this secret). This is the `secret` segment of the anon/service JWTs.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
# Optional anon key; used only to build user-scoped clients (RLS path).
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# SMTP
SMTP_USER=your_email_here
SMTP_PASS=your_app_password_here

# Turnstile
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# CORS
CLIENT_URL=http://localhost:5173
