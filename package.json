{
  "name": "ctu-naga-alumni-connect",
  "version": "1.0.0",
  "private": true,
  "description": "CTU-Naga Alumni Connect - Bridging Education to Eternity",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install",
    "seed:schema": "node scripts/run-schema.mjs",
    "seed:admin": "echo 'Use the Admin Dashboard → Seed Data panel (requires running server + admin login)'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "file-type": "^13.1.2",
    "nodemailer": "^8.0.9",
    "sanitize-html": "2.11.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
